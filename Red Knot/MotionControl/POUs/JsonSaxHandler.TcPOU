    <Method Name="OnString" Id="{1c13bada-871d-4b30-bee1-08ea70607c6f}">
      <Declaration><![CDATA[{attribute 'show'}
{attribute 'c++_compatible'}
{attribute 'minimal_input_size' := '4'}
{attribute 'pack_mode' := '4'}
METHOD OnString : HRESULT
VAR_IN_OUT CONSTANT
	value	: STRING;
END_VAR
VAR_INPUT
	len	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// IF (eState = 50) THEN
// 	bTimestampValueFound := TRUE;
// 	STRNCPY(pDst:=ADR(sTimestamp), pSrc:=ADR(value), nDstSize:=SIZEOF(sTimestamp));
// 	eState := 60;
// ELSE
// 	bError := TRUE;
// 	OnString := S_FALSE;
// END_IF

	IF label = 'MOTION/INSTR_BUFFER' THEN
		IF tempkey = 'Comment' THEN
			GVL_MOTION.TestBuffer.Comment		:= value;
		END_IF
	ELSIF label = 'MOTION/CTR' THEN
		IF tempkey = 'SCRIPTNAME' THEN
			GVL_MOTION.TEST_CTR.SCRIPTNAME		:= value;
		END_IF	
	END_IF
	
	]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnUdint" Id="{296ac94a-f1f7-4890-a4b8-5d9fd3b55ce6}">
      <Declaration><![CDATA[{attribute 'show'}
{attribute 'c++_compatible'}
{attribute 'minimal_input_size' := '4'}
{attribute 'pack_mode' := '4'}
METHOD OnUdint : HRESULT
VAR_INPUT
	value		:UDINT;
END_VAR
VAR
	//temptime	:TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// IF (eState = 90) THEN
// 	bSensor2ValueFound := TRUE;
// 	Sensor2 := value;
// 	eState := 100;
// ELSE
// 	bError := TRUE;TO_TIME
// 	OnUdint := S_FALSE;
// END_IF

	IF label = 'MOTION/INSTR_BUFFER' THEN
		IF tempkey = 'MotionCommand' THEN
			GVL_MOTION.TestBuffer.MotionCommand		:= UDINT_TO_INT(value);
		ELSIF tempkey = 'zType' THEN
			GVL_MOTION.TestBuffer.zType				:= UDINT_TO_INT(value);
		ELSIF tempkey = 'DataTrigger' THEN
			GVL_MOTION.TestBuffer.DataTrigger		:= UDINT_TO_INT(value);	
		ELSIF tempkey = 'SetXPosition' THEN
			GVL_MOTION.TestBuffer.SetXPosition		:= UDINT_TO_INT(value);
		ELSIF tempkey = 'SetXVelocity' THEN
			GVL_MOTION.TestBuffer.SetXVelocity		:= UDINT_TO_INT(value);
		ELSIF tempkey = 'SetXAccel' THEN
			GVL_MOTION.TestBuffer.SetXAccel			:= UDINT_TO_INT(value);
		ELSIF tempkey = 'SetYPosition' THEN
			GVL_MOTION.TestBuffer.SetYPosition		:= UDINT_TO_INT(value);
		ELSIF tempkey = 'SetYVelocity' THEN
			GVL_MOTION.TestBuffer.SetYVelocity		:= UDINT_TO_INT(value);
		ELSIF tempkey = 'SetYAccel' THEN
			GVL_MOTION.TestBuffer.SetYAccel			:= UDINT_TO_INT(value);
		ELSIF tempkey = 'SetZPosition' THEN
			GVL_MOTION.TestBuffer.SetZPosition		:= UDINT_TO_INT(value);
		ELSIF tempkey = 'SetZVelocity' THEN
			GVL_MOTION.TestBuffer.SetZVelocity		:= UDINT_TO_INT(value);			
		ELSIF tempkey = 'PauseTime' THEN
			//temptime := TIME#1MS * value;
			GVL_MOTION.TestBuffer.PauseTime 		:= TIME#1MS * value;
		END_IF		
	ELSIF label = 'DAQ/CTR' THEN
		IF tempkey = 'DAQRES' THEN
			GVL_DAQ.TEST_CTR.DAQRES				:= UDINT_TO_INT(value);
		END_IF	
	ELSIF label = 'MOTION/CTR' THEN	
		IF tempkey = 'SCRIPTITERATIONS' THEN 	
			GVL_MOTION.TEST_CTR.SCRIPTITERATIONS	:= UDINT_TO_INT(value);	
		END_IF
		
	END_IF
]]></ST>
      </Implementation>
    </Method>
