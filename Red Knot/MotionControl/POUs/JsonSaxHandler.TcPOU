<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.12">
  <POU Name="JsonSaxHandler" Id="{fd22ba04-0d36-44e7-a81e-c59d3ac0f333}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'c++_compatible'}
FUNCTION_BLOCK JsonSaxHandler IMPLEMENTS ITcJsonSaxHandler
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	(* Values from JSON - written by callback methods *)	  
	keystate			: INT := 0;
	label				: STRING(255);
	tempkey				: STRING(255);
	
	(* State machine variables *)
	//eState				: E_JsonStates;
	
	(* Indicators if an expected property has been found in JSON *)
	bStartObjectFound 	: BOOL;
	bEndObjectFound		: BOOL;
	
	(* Error indicators *)
	bError				: BOOL;
	sErrorMsg			: STRING(255);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bError THEN
	sErrorMsg := 'JSON message does not equal expected format';
END_IF
]]></ST>
    </Implementation>
    <Method Name="OnBool" Id="{13455f88-e234-4d6f-b163-c3ace2d01de9}">
      <Declaration><![CDATA[{attribute 'show'}
{attribute 'c++_compatible'}
{attribute 'minimal_input_size' := '4'}
{attribute 'pack_mode' := '4'}
METHOD OnBool : HRESULT
VAR_INPUT
	value	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
	IF label = 'MOTION/CTR' THEN
		IF tempkey = 'CMDADD' THEN
			GVL_MOTION.TEST_CTR.CMDADD := value;
		ELSIF tempkey = 'CMDCLR' THEN
			GVL_MOTION.TEST_CTR.CMDCLR := value;
		ELSIF tempkey = 'CMDDEL' THEN
			GVL_MOTION.TEST_CTR.CMDDEL := value;	
		ELSIF tempkey = 'CMDRUN' THEN
			GVL_MOTION.TEST_CTR.CMDRUN := value;
		ELSIF tempkey = 'CMDHOME' THEN
			GVL_MOTION.TEST_CTR.CMDHOME := value;
		ELSIF tempkey = 'CMDSETZLIM' THEN
			GVL_MOTION.TEST_CTR.CMDSETZLIM := value;
		ELSIF tempkey = 'CMDFINDSTOPS' THEN
			GVL_MOTION.TEST_CTR.CMDFINDSTOPS := value;				
		ELSIF tempkey = 'CMDLOOP' THEN
			GVL_MOTION.TEST_CTR.CMDLOOP := value;	
		ELSIF tempkey = 'AXESHALT' THEN
			GVL_MOTION.TEST_CTR.AXESHALT := value;	
		ELSIF tempkey = 'AXESEN' THEN
			GVL_MOTION.TEST_CTR.AXESEN := value;		
		ELSIF tempkey = 'AXESRESET' THEN
			GVL_MOTION.TEST_CTR.AXESRESET := value;	
		ELSIF tempkey = 'CMDSCRIPTWRITE' THEN
			GVL_MOTION.TEST_CTR.CMDSCRIPTWRITE := value;
		ELSIF tempkey = 'CMDSCRIPTREAD' THEN
			GVL_MOTION.TEST_CTR.CMDSCRIPTREAD := value;	
		END_IF		
	ELSIF label = 'DAQ/CTR' THEN
		IF tempkey = 'CMDDATACLR' THEN
			GVL_DAQ.TEST_CTR.CMDDATACLR := value;	
		ELSIF tempkey = 'CMDDATAAPEND' THEN
			GVL_DAQ.TEST_CTR.CMDDATAAPEND := value;
		ELSIF tempkey = 'CMDDATAWRITE' THEN
			GVL_DAQ.TEST_CTR.CMDDATAWRITE := value;
		END_IF	
	ELSIF label = 'MOTION/INSTR_BUFFER' THEN
		IF tempkey = 'Acq_Keyence' THEN
			GVL_MOTION.TestBuffer.Acq_Keyence := value;
		ELSIF tempkey = 'Acq_Massa' THEN
			GVL_MOTION.TestBuffer.Acq_Massa := value;
		ELSIF tempkey = 'Acq_Sonar' THEN
			GVL_MOTION.TestBuffer.Acq_Sonar := value;
		END_IF	
		
	END_IF

]]></ST>
      </Implementation>
    </Method>
