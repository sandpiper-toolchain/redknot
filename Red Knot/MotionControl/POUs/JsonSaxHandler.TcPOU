    <Method Name="OnLreal" Id="{e458c372-d873-4613-adb7-f607191d076c}">
      <Declaration><![CDATA[{attribute 'show'}
{attribute 'c++_compatible'}
{attribute 'minimal_input_size' := '4'}
{attribute 'pack_mode' := '4'}
METHOD OnLreal : HRESULT
VAR_INPUT
	value	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// IF (eState = 70) THEN
// 	bSensor1ValueFound := TRUE;
// 	Sensor1 := value;
// 	eState := 80;
// ELSE
// 	bError := TRUE;
// 	OnLreal := S_FALSE;
// END_IF

	IF label = 'MOTION/INSTR_BUFFER' THEN
		IF tempkey = 'SetXPosition' THEN
			GVL_MOTION.TestBuffer.SetXPosition		:= value;
		ELSIF tempkey = 'SetYPosition' THEN
			GVL_MOTION.TestBuffer.SetYPosition		:= value;
		ELSIF tempkey = 'SetZPosition' THEN
			GVL_MOTION.TestBuffer.SetZPosition		:= value;	
		END_IF
		
	END_IF
	]]></ST>
      </Implementation>
    </Method>
