END_VAR
VAR_INPUT
	len	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[

// IF keystate = 1 THEN
// 	label := key;
// ELSIF keystate > 1 THEN
// 	tempkey	:= key;
// 	bStartObjectFound := FALSE;
// END_IF

tempkey	:= key;



