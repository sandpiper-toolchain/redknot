<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.12">
  <GVL Name="GVL_MOTION" Id="{ea33deb8-8627-4a0d-a3f0-288faa3aa9d9}">
    <Declaration><![CDATA[//variables must be referenced GVL_MOTION.etc b/c of attribute
{attribute 'qualified_only'}
VAR_GLOBAL PERSISTENT
	//motor control signals
	
	xCon					:CTR_SIGNALS_INTERNAL;
	yCon					:CTR_SIGNALS_INTERNAL;	
	zCon					:CTR_SIGNALS_INTERNAL;
	
	//external controls
	
	EXT_CTR					:MOTION_CTR; 
	TEST_CTR				:MOTION_CTR; //test buffer for MQTT
	
	//script variables
	
	InstructionBuffer		:MOTION_INSTRUCTION; //set externally (MQTT) or locally
	TestBuffer				:MOTION_INSTRUCTION; //test buffer for MQTT
	EmptyInstruction		:MOTION_INSTRUCTION;
	Script 					:ARRAY[0..99] OF MOTION_INSTRUCTION; //add commands from instruction buffer or load script
	ScriptReadBuffer		:ARRAY[0..99] OF MOTION_INSTRUCTION; //buffer for ScriptRead
	ContinuousMode			:BOOL; //override number of script runs and run until set false
	ScriptEnd				:INT						:= 0; //empty/not executed
	InstructionState		:INT						:= 0; //control case statement in RunCommands
	TxtBxWaitOK				:BOOL						:= TRUE; //hide text box
	HaltMem					:BOOL						:= FALSE; //part of the waitOK motion button control

	//output signals
	
	STATUS					:STATUS;
	
	xOut					:OUT_SIGNALS;
	xCOut					:OUT_SIGNALS;
	yOut					:OUT_SIGNALS;	
	zOut					:OUT_SIGNALS;
	xHomeStatus				:MOTION_FB_STATUS;
	xCHomeStatus			:MOTION_FB_STATUS;
	yHomeStatus				:MOTION_FB_STATUS;
	zHomeStatus				:MOTION_FB_STATUS;
	
	CurInstruction			:INT						:= 0; //current instruction
	NextInstruction			:INT; //only for display
	RUN_INDEX				:INT						:= 1; //increment after script run
	
	//for the drop down lists
	
	xyzCMDSelect			:ARRAY[0..3] OF MotionType	:= [0,1,2,3];
	zMODESelect				:ARRAY[0..2] OF zBehavior	:= [0,1,2];
	TriggerOn				:ARRAY[0..4] OF DataTrigger	:= [0,1,2,3,4];
	
	//safety controls

	zSafeDisable			:BOOL						:= FALSE; 	(*in zAxisMoreLogic*)
	zSafePosition			:LREAL						:= 0;	
	HardStopState			:INT						:= 0;
	HardStopLocations		:ARRAY[0..2] OF LREAL		:= [0,0,0];
	
	//homing variables
	
	HomingState				:INT						:= 0;
	RevCouplePrep			:BOOL						:= FALSE;
END_VAR

VAR_GLOBAL
	HomeDone				:BOOL						:= FALSE;
	zSafeSet				:BOOL						:= FALSE;							
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>