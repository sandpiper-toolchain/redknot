<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.12">
  <GVL Name="GVL_SICK" Id="{f7d82ed7-93ca-4fbd-91f5-cda0a024e728}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
	//SICK_Control
	//outgoing
	SCAN_DONE	AT %I*	:UDINT	:= 0; //send 1 to cpp when scan motion complete
	SWATH_CNT	AT %I*	:UDINT	:= 0; //numbering for scans
	SCAN_HEIGHT	AT %I*	:UDINT	:= 0; //# profiles per buffer. 1-65535
	CNT_PER_REV	AT %I*	:UDINT	:= 0; //# encoder cnts before trigger 1-65535
	Y_POS		AT %I*	:REAL	:= 0;
	BASIN		AT %I*	:STRING;
	SCRIPT		AT %I*	:STRING;
	
	//incoming
	INIT_DONE	AT %I*	:UDINT	:= 0; //cpp sets to 1 when ready to start scan
	DATA_DONE	AT %I*	:UDINT	:= 0; //cpp sets to 1 when data is processed and script can proceed
	
	//section_overlap
	MOVE_DONE	AT %I*	:UDINT	:= 0; //send 1 to plc to trigger profile capture
	NUM_SWATHS	AT %I*	:UDINT	:= 0; //max 5
	
	//internal
	SICK_setup			:BOOL	:= FALSE;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>