<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.12">
  <DUT Name="MOTION_CTR" Id="{7b736c67-30bf-4989-9a85-4ad577225276}">
    <Declaration><![CDATA[TYPE MOTION_CTR :
STRUCT
	CMDADD					:BOOL	:= FALSE; //add instruction to script
	CMDCLR					:BOOL	:= FALSE; //clear script
	CMDDEL					:BOOL	:= FALSE; //delete instruction at end of script
	CMDRUN					:BOOL	:= FALSE; //run script if all safety conditions are met (homed, hard stops located, x axes coupled, safe z set)
	CMDHOME					:BOOL	:= FALSE; //run home routine
	CMDSETZLIM				:BOOL	:= FALSE; //this will set the safe lower limit of z to where it is currently positioned
	CMDFINDSTOPS			:BOOL	:= FALSE; //run find stops routine
	CMDLOOP					:BOOL	:= FALSE; //sets script to run indefinitely and forces separate data files for each script run
	AXESHALT				:BOOL	:= FALSE; //pause motion during script run if true. set to false to continue motion
	AXESEN					:BOOL	:= FALSE; //sends enable signal to all axes
	(*deactivate daq trigger, reset home and hardstop states,  *)
	AXESRESET				:BOOL	:= FALSE; //sends reset signal to each axis sequentially. ResetAxes program has some coupling logic to ensure both x axes reset
	CMDSCRIPTWRITE			:BOOL	:= FALSE; //write script to file based on script name entered
	CMDSCRIPTREAD			:BOOL	:= FALSE; //read script from file based on script name
	(*maybe make new struct for script data *)
	SCRIPTITERATIONS		:INT	:= 1; //number of times a script will be executed in a run
	SCRIPTNAME				:T_MaxString; //name of script for data and script files.
	BASINNAME				:T_MaxString; //name of basin, and folder for all associated data and scripts
	USEBASINCOORDINATES		:BOOL	:= FALSE; //use basin coordinate system in the interface and data output
	BASINCTR				:BOOL	:= FALSE;
	DEFAULTBASIN			:BOOL	:= FALSE;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>