  <DUT Name="STATUS" Id="{f85b29e1-bc75-46b4-af59-e2e0fcb03fd0}">
    <Declaration><![CDATA[TYPE STATUS :
STRUCT
	MoveActive			:BOOL;
	eStop				:BOOL;
	
	Rack_Err			:BOOL	:= FALSE;
	Script_Open_Err		:BOOL	:= FALSE;	
	Script_Read_Err		:BOOL	:= FALSE;
	Move_Rel_Err		:BOOL 	:= FALSE;
	Move_Abs_Err		:BOOL	:= FALSE;
	HS_Err				:BOOL	:= FALSE;
	Basin_Exceed_Err	:BOOL	:= FALSE;
	Basin_Set_Err		:BOOL	:= FALSE;
	
	AxesLocated			:BOOL	:= FALSE;
	//HardStopLoc			:BOOL	:= FALSE; 
	//zSafeSet			:BOOL	:= FALSE;
	//BasinSet			:BOOL	:= FALSE;
	HaltDone			:BOOL	:= FALSE;
	PowerError			:BOOL	:= FALSE;
	
	CurInstr			:INT;
	NextInstr			:INT;
	RUN_INDEX			:INT;
	
	xCoupled			:BOOL;
	xPosOut				:LREAL;
	xVelOut				:LREAL;
	yPosOut				:LREAL;
	yVelOut				:LREAL;
	zPosOut				:LREAL;
	zVelOut				:LREAL;
	
	MASSA_TEMP			:LREAL;
	KEYENCE_TEMP		:LREAL;
	//includes carriage offsets, hardcoded
	HardStopLocations	:ARRAY[0..2] 	  OF LREAL	:= [485,455,120]; 
	KEYENCE_OFFSETS		:ARRAY[0..2]	  OF LREAL	:= [53.52,108.41,23.9];
	MASSA_OFFSETS		:ARRAY[0..2]	  OF LREAL	:= [36,31,-116.11];
	
	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
