<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="MOTION_INSTRUCTION" Id="{9fd3883a-1252-4d24-bb11-8c78b46defc4}">
    <Declaration><![CDATA[TYPE MOTION_INSTRUCTION :
STRUCT
	(*motion type*)
	MotionCommand 			:MotionType;
	SetXPosition			:REAL;
	SetXVelocity			:INT;
	SetXAccel				:INT;
	SetYPosition			:REAL;	
	SetYVelocity			:INT;
	SetYAccel				:INT;
	SetZPosition			:REAL;
	SetZVelocity			:INT := 10;
	PauseTime				:TIME;	//comes in as UDINT in MS, variable format T#1D4H5M2S1MS
	Comment					:STRING;

END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>